class StdoutWrapper:
    """
    Wrapper around stdout that ensures 'bytes' data is decoded
    to 'latin1' (0x00 - 0xff) before writing out. This is necessary for
    the invisible font to be injected as bytes but written out as a string.
    """

    def write(self, data, *args, **kwargs):
        if bytes != str and isinstance(data, bytes):
            data = data.decode('latin1')
        sys.stdout.write(data)


def export_pdf(playground, default_dpi, reverse, savefile=False):
    """Create a searchable PDF from a pile of HOCR + JPEG"""
    images = sorted(glob.glob(os.path.join(playground, '*.jpg')))
    if len(images) == 0:
        print(f"WARNING: No JPG images found in the folder {playground}"
              "\nScript cannot proceed without them and will terminate now.\n")
        sys.exit(0)
    load_cour_font()
    pdf = Canvas(savefile if savefile else StdoutWrapper(), pageCompression=1)
    pdf.setCreator('hocr-tools')
    pdf.setTitle(os.path.basename(playground))
    for image in images:
        im = Image.open(image)
        w, h = im.size
        logging.debug("image dimensions (%s): %s", image, im.size)
        dpi = im.info['dpi'][0]
        width = w * 72 / dpi
        height = h * 72 / dpi
        pdf.setPageSize((width, height))
        pdf.drawImage(image, 0, 0, width=width, height=height)
        add_text_layer(pdf, image, height, dpi, w, reverse)
        pdf.showPage()
    pdf.save()


def add_text_layer(pdf, image, height, dpi, img_width, reverse):
    """Draw an invisible text layer for OCR data"""
    p1 = re.compile(r'bbox((\s+-?\d+){4})')
    p2 = re.compile(r'baseline((\s+[\d\.\-]+){2})')

    hocrfile = os.path.splitext(image)[0] + ".hocr"
    hocr = html.parse(hocrfile)

    scale_to_pts = calc_scale_pts(hocr, dpi, img_width)

    lang = get_language(hocr)
    logging.debug("language %s: %s", hocrfile, lang)

    if reverse == "lang":
        if lang:
            reverse = "yes" if is_rtl_lang(lang) else "no"
        else:
            raise ValueError(f"Missing or empty language in file {hocrfile}")

    line_xpath = '//*[@class="ocr_line" or @class="ocrx_line"]'
    for i, line in enumerate(hocr.xpath(line_xpath), start=1):
        logging.debug(f"Processing LINE #{i}")

        linebox = p1.search(line.attrib['title']).group(1).split()
        try:
            baseline = p2.search(line.attrib['title']).group(1).split()
        except AttributeError:
            baseline = [0, 0]
        linebox = [max(float(i), 0.0) for i in linebox]
        baseline = [max(float(i), 0.0) for i in baseline]
        xpath_elements = './/*[@class="ocrx_word"]'
        if (not (line.xpath('boolean(' + xpath_elements + ')'))):
            # if there are no words elements present,
            # we switch to lines as elements
            xpath_elements = '.'

        # collect word info and accumulate Arabic counts
        words_info = []  # list of dicts: {'raw':..., 'fixed':..., 'has_ar':bool, 'box':[...] }
        arabic_chars = 0
        total_chars = 0

        for word in line.xpath(xpath_elements):
            raw = word.text_content().strip()
            if not raw:
                continue

            # Apply visual->logical fix once
            fixed = fix_word(raw)

            # bounding box
            title = word.attrib.get("title", "")
            m = p1.search(title)
            if not m:
                continue
            box = [max(float(i), 0.0) for i in m.group(1).split()]

            # detect whether this fixed token contains any Arabic
            has_ar = any(is_arabic_char(ch) for ch in fixed)

            # accumulate for line-level decision (we count characters,
            # not tokens)
            arabic_chars += sum(1 for ch in fixed if is_arabic_char(ch))
            total_chars += len(fixed)

            word_data = {
                "raw": raw,
                "fixed": fixed,
                "has_ar": has_ar,
                "box": box,
                "elem": word,  # optional: original element if you need it
            }
            logging.debug("word:\n%s", pp.pformat(word_data))
            words_info.append(word_data)

        # decide line direction once
        line_rtl = (total_chars > 0) and ((arabic_chars / total_chars) > 0.35)

        if not words_info:
            continue

        # sort words from left to right
        words_info.sort(key=lambda w: w["box"][0])

        # --- BUILD LINE STRING ---
        line_text = " ".join(
            reverse_handler[reverse](w["raw"]) for w in words_info
        )

        # --- GEOMETRY: use full line box ---
        x0 = min(w["box"][0] for w in words_info)
        x1 = max(w["box"][2] for w in words_info)

        box_height = max(w["box"][3] - w["box"][1] for w in words_info)
        font_size = int(box_height * scale_to_pts * 0.75)
        logging.debug(f"font size: {font_size}")

        font_name = "CourierNew"
        font_width = pdf.stringWidth(line_text, font_name, font_size)
        logging.debug(f"font width: {font_width}")
        if font_width <= 0:
            continue

        b = polyval(baseline, ((x0 + x1) / 2) - linebox[0]) + linebox[3]

        # --- SINGLE TEXT OBJECT PER LINE ---
        text = pdf.beginText()
        text.setTextRenderMode(3)  # invisible
        text.setFont(font_name, font_size)
        text.setTextOrigin(x0 * scale_to_pts, height - b * scale_to_pts)

        line_width = (x1 - x0) * scale_to_pts
        logging.debug(f"line width: {line_width}")

        horiz_scale = 100.0 * line_width / font_width
        logging.debug(f"horizontal scale: {horiz_scale}")
        text.setHorizScale(horiz_scale)

        # EXACTLY ONE CALL
        text.textLine(line_text)

        pdf.drawText(text)


def polyval(poly, x):
    return x * poly[0] + poly[1]


